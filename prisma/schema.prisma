generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  KUSF_ADMIN
  UNIVERSITY_ADMIN
  SPORTS_OFFICER
  TEAM_CAPTAIN
  COACH
  ATHLETE
  MATCH_OFFICIAL
  REFEREE
  VIEWER
}

enum EligibilityStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationType {
  INFO
  WARNING
  ACTION_REQUIRED
}

enum ReportStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role
  approved     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  universityId String?
  university   University? @relation(fields: [universityId], references: [id])

  athlete           Athlete?
  coachedTeams      Team[]        @relation("TeamCoach")
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  reports           Report[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  title      String
  message    String
  type       NotificationType @default(INFO)
  readAt     DateTime?
  metadata   Json?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id          String       @id @default(uuid())
  name        String
  type        String
  generatedBy String
  filters     Json?
  result      Json?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [generatedBy], references: [id], onDelete: Cascade)
}

model University {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminUsers User[]
  athletes   Athlete[]
  teams      Team[]
  students   UniversityStudent[]
  disciplinaryCases DisciplinaryCase[]
}

model Sport {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athletes Athlete[]
  teams    Team[]
}

model Athlete {
  id               String             @id @default(uuid())
  userId           String             @unique
  universityStudentId String? @map("university_student_id")
  fullName         String
  dateOfBirth      DateTime
  gender           String
  nationality      String
  phone            String?
  profilePhoto     String?
  universityId     String
  sportId          String
  eligibilityStatus EligibilityStatus @default(PENDING)
  verificationStatus VerificationStatus @default(PENDING)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  university University @relation(fields: [universityId], references: [id])
  sport      Sport      @relation(fields: [sportId], references: [id])

  universityStudent UniversityStudent? @relation(fields: [universityStudentId], references: [id])

  qrTokens          QrToken[]
  attendanceRecords AttendanceRecord[]
  disciplinaryCases DisciplinaryCase[]
  appeals           Appeal[]
  documents         Document[]
  eligibilityRecords EligibilityRecord[]
  teamLinks         TeamAthlete[]
}

model Team {
  id          String   @id @default(uuid())
  name        String
  universityId String
  sportId     String
  coachId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  university University @relation(fields: [universityId], references: [id])
  sport      Sport      @relation(fields: [sportId], references: [id])
  coach      User       @relation("TeamCoach", fields: [coachId], references: [id])

  athletes   TeamAthlete[]
  competitions CompetitionTeam[]
  results    CompetitionResult[]
}

model TeamAthlete {
  id        String   @id @default(uuid())
  teamId    String
  athleteId String
  joinedAt  DateTime @default(now())

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@unique([teamId, athleteId])
}

model Competition {
  id          String   @id @default(uuid())
  name        String
  date        DateTime
  location    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teams CompetitionTeam[]
  results CompetitionResult[]
}

model CompetitionTeam {
  id            String @id @default(uuid())
  competitionId String
  teamId        String

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([competitionId, teamId])
}

model CompetitionResult {
  id            String      @id @default(uuid())
  competitionId String
  teamId        String
  result        String
  position      Int?
  score         Int?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([competitionId, teamId])
}

model EligibilityRecord {
  id                  String             @id @default(uuid())
  athleteId           String
  academicStatus     String
  verificationStatus  VerificationStatus @default(PENDING)
  approvalHistory     Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model Document {
  id                String          @id @default(uuid())
  athleteId         String
  documentType      String
  fileUrl           String
  verificationStatus DocumentStatus @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model QrToken {
  id         String   @id @default(uuid())
  athleteId  String
  token      String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]
}

model AttendanceRecord {
  id         String   @id @default(uuid())
  athleteId  String
  qrTokenId  String
  eventType  String   @default("MATCH_CHECKIN")
  status     String   @default("PRESENT")
  location   String?
  createdAt  DateTime @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  qrToken QrToken @relation(fields: [qrTokenId], references: [id], onDelete: Cascade)
}

enum DisciplinaryStatus {
  OPEN
  UNDER_REVIEW
  CLOSED
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

model DisciplinaryCase {
  id               String             @id @default(uuid())
  athleteId        String
  universityId     String
  offense          String
  description      String
  incidentDate     DateTime
  status           DisciplinaryStatus @default(OPEN)
  decision         String?
  banPeriodDays    Int?
  banStartDate     DateTime?
  banEndDate       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  university University @relation(fields: [universityId], references: [id])
  appeals Appeal[]
}

model Appeal {
  id                 String        @id @default(uuid())
  disciplinaryCaseId String
  athleteId          String
  requestDetails     String
  status             AppealStatus  @default(PENDING)
  reviewedBy         String?
  reviewedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  disciplinaryCase DisciplinaryCase @relation(fields: [disciplinaryCaseId], references: [id], onDelete: Cascade)
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

model UniversityStudent {
  id                     String   @id @default(uuid())
  universityId           String
  university             University @relation(fields: [universityId], references: [id])
  universityStudentId    String   @unique
  registrationNumber     String
  fullName               String
  dateOfBirth            DateTime
  gender                 String?
  photoUrl               String?
  admissionDate          DateTime?
  expectedGraduationDate DateTime?
  actualGraduationDate   DateTime?
  enrollmentStatus       String
  academicStatus         String
  graduationStatus       String
  suspensionStatus       String
  expulsionStatus        String
  disciplinaryStatus     String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  athletes Athlete[]
}
